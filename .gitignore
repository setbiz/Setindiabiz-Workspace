# Raw exports: may contain personal data (DPDP Act, 2023)
**/imports/chatgpt/raw/*
!**/imports/chatgpt/raw/.gitkeep
*.zip

# Customer / audience lists: never commit
**/audiences/*.csv
**/audiences/*.xlsx
*customer*list*
*.pii.*

# Secrets
.env
.env.*
*.key
*credentials*.json
*token*

# OS / editor
.DS_Store
__pycache__/

# Any spreadsheet/contact export anywhere in PPC (compliance review 2026-11-02)
PPC/**/*.csv
PPC/**/*.xlsx
*contacts*
